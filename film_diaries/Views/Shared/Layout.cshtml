<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Antonio:wght@100..700&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Michroma&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Antonio:wght@100..700&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link href="~/Content/css/style.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav>
        <div class="nav-left">
            <a href="@Url.Action("Index", "Home")" class="logo">FilmDiaries</a>
            <form>
                <div class="search">
                    <input class="search-input" type="search" placeholder="click to search...">
                    <span class="search-icon material-symbols-outlined">search</span>
                </div>
            </form>
        </div>
        <div class="nav-right">
            <div class="nav-links">
            <a href="@Url.Action("Index", "Movies")" class="link-text">movies</a>
            <a href="@Url.Action("Index", "Series")" class="link-text">series</a>
            <a href="@Url.Action("About", "Home")" class="link-text">about us</a>
            <a href="@Url.Action("Contact", "Home")" class="link-text">contact us</a>
            </div>
            <div class="profile">
                <span class="profile-icon material-symbols-outlined">account_circle</span>
                <!-- Açılır Menü (Popup) -->
                <div class="profile-popup" id="profilePopup">
                    <div class="popup-header">
                        <a class="popup-title" href="#">My Profile</a>
                        <span class="header-icon material-symbols-outlined">account_circle</span>
                    </div>
                    <div class="popup-divider"></div>
                    <ul class="popup-menu">
                        <li><a href="@Url.Action("MyList", "Account")">My List</a></li>
                        <li><a href="#">Watch History</a></li>
                        <li><a href="#">Settings</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer>
        <p>&copy; 2026 COM5005 GROUP 16</p>
    </footer>

    <script src="~/Scripts/index.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
