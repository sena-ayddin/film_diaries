@{
    ViewBag.Title = "Contact Us - FilmDiaries";
}

@section Styles {
    <link href="~/Content/css/user_contact_us.css" rel="stylesheet" />
}

    <main class="contact-page">
    <h1>How can we help you?</h1>
    
    <section class="faq-section">
    <details class="faq-item">
        <summary>
            <span class="faq-title">Account & Profile</span>
            <span class="faq-desc">Account access, password reset, profile settings, account deletion.</span>
        </summary>
        <p class="faq-answer">This part is for Account and Profile.</p>
    </details>

    <details class="faq-item">
        <summary>
            <span class="faq-title">Streaming & Playback</span>
            <span class="faq-desc">Video playback errors, music playback, buffering, subtitles and audio issues.</span>
        </summary>
        <p class="faq-answer">This part is for Streaming and Playback.</p>
    </details>

    <details class="faq-item">
        <summary>
            <span class="faq-title">Store & Purchases</span>
            <span class="faq-desc">Purchases, rentals, payment problems, refunds and order history.</span>
        </summary>
        <p class="faq-answer">This part is for Store and Purchases.</p>
    </details>

    <details class="faq-item">
        <summary>
            <span class="faq-title">Subscription & Billing</span>
            <span class="faq-desc">Subscription plans, billing errors, cancellations and payment methods.</span>
        </summary>
        <p class="faq-answer">This part is for Subscription and Billing.</p>
    </details>

    <details class="faq-item">
        <summary>
            <span class="faq-title">Feedback & Suggestions</span>
            <span class="faq-desc">Feature requests, recommendations and ideas to improve the platform.</span>
        </summary>
        <p class="faq-answer">This part is for Feedback and Suggestions.</p>
    </details>

    <details class="faq-item">
        <summary>
            <span class="faq-title">Privacy & Security</span>
            <span class="faq-desc">Privacy concerns, suspicious activity, data requests and security issues.</span>
        </summary>
        <p class="faq-answer">This part is for Privacy and Security.</p>
    </details>
</section>

    <h2>Can't find what you need? Contact us</h2>
    
<form id="contactForm" class="contact-form">
    <div class="form-group">
        <label for="name">Your name</label>
        <input type="text" id="name">
    </div>

    <div class="form-group">
        <div class="form-group-label">
            <label for="email">Your email</label>
        </div>
        <input type="email" id="email" required>
        <span class="mandatory">*mandatory</span>
    </div>

    <div class="form-group">
        <label for="topic">Topic</label>
        <input type="text" id="topic">
    </div>

    <div class="form-group">
        <div class="form-group-label">
            <label for="message">Message</label>
        </div>
        <div class="textarea-wrapper">
            <textarea id="message"></textarea>
            <span class="char-count">0/2000</span>
        </div>
        <span class="mandatory">*mandatory</span>
    </div>

    <button type="submit">Send message</button>
</form>
</main>
    <a href="@Url.Action("Index", "Home")" class="back-btn">← Back to Home Page</a>

@section Scripts {
    <script src="~/Scripts/contact.js"></script>
}
