@{
    ViewBag.Title = "Home - FilmDiaries";
}
@section Styles {
    <link rel="stylesheet" href="~/Content/css/user_home.css" />
}
<!-- sponsor ----------------------------------------------------------------------------------------- -->
<section class="sponsor">
    <div class="sponsor-movie">
        <div class="movie-info">
            <p>Comedy/Romance</p>
            <p>1h 37m</p>
        </div>
        <h1>10 THINGS I HATE ABOUT YOU</h1>
        <h6>
            As soon as Cameron, a newbie at Padua High School,
            finds Bianca, he falls in love with her. However,
            to date Bianca, he must first get her older sister Kate,
            a mean feminist, to date someone.
        </h6>
    </div>
    <div class="sponsor-purchase-options">
        <div class="sponsor-one-time">
            <h6>One Time Purchase</h6>
            <p>Pay once to rent Premium Movies only.</p>
            <h7>[Movie Price]₺ one time.</h7>
        </div>
        <div class="sponsor-join">
            <h6>Join us</h6>
            <p>Unlimited access to every premium movie. Cancel any time.</p>
            <h7>[Monthly Price]₺ per month</h7>
        </div>
    </div>
</section>
